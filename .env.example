# Servidor
ADDR=:8080
APP_MODE=demo
TIKTOK_CHANNEL=demo_canal
ALLOWED_ORIGIN=*
MAX_PAYLOAD_BYTES=65536
QUEUE_SIZE=120

# Reconexión
RECONNECT_BASE=1s
RECONNECT_MAX=20s
RECONNECT_MAX_ATTEMPTS=0
HEARTBEAT_TIMEOUT=20s

# Demo
DEMO_INTERVAL=1200ms
DEMO_DROP_EVERY=18

# Webhook TikTools
WEBHOOK_SECRET=change-me-demo-secret
WEBHOOK_SIGNATURE_HEADER=X-Tiktools-Signature

# Integraciones externas (plantillas, no implementan API propietaria)
TIKTOK_CONNECTOR_ENDPOINT=https://example.invalid/tiktok-live
TIKTOOLS_ENDPOINT=https://example.invalid/tiktools
